# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/SANQOBA?retryWrites=true&w=majority
# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
# Optional: Groq API key (https://console.groq.com/keys) for live AI commentary and the AI NPC strategist.
# Without it the game uses the built-in commentator and NPC strategy.
GROQ_API_KEY=gsk_...
# Optional: any chat model your Groq account lists (defaults to qwen/qwen3.8-27b)
GROQ_MODEL=qwen/qwen3.8-27b
# Comma-separated browser origins allowed to call the API in development (Expo web dev server)
CORS_ORIGINS=http://localhost:8081
