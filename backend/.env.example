# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/SANQOBA?retryWrites=true&w=majority
# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
# Optional: enables GPT commentary and the AI NPC strategist (game falls back to rule-based play without it)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Comma-separated browser origins allowed to call the API in development (Expo web dev server)
CORS_ORIGINS=http://localhost:8081
