{
  "expo": {
    "name": "SA-NQOBA",
    "slug": "sa-nqoba",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sa-nqoba-logo.jpeg",
    "scheme": "sanqoba",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1C19",
        "foregroundImage": "./assets/images/sa-nqoba-logo.jpeg"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/sa-nqoba-logo.jpeg",
      "name": "SA-NQOBA",
      "shortName": "SA-NQOBA",
      "themeColor": "#1A1C19",
      "backgroundColor": "#A5C6D6"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1C19",
          "image": "./assets/images/splash-logo.jpeg",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
